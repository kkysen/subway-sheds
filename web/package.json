{
  "name": "subway-sheds-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "cd times && cargo build --release",
    "icons": "../scripts/fetch-icons.sh",
    "dev": "bun run wasm && bun run icons && vite",
    "build": "bun run wasm && bun run icons && tsrs --noEmit && vite build",
    "check": "tsrs --noEmit && biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/geojson": "^7946.0.16",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "zstddec": "^0.3.4"
  }
}
